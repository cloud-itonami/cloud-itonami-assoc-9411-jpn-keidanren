;; The KEIDANREN source catalog, as Kotoba.
;;
;; GENERATED by tools/gen_kotoba.cljs from data/datascript-tx.edn, which
;; src/association/facts.cljc holds as a hand-authored literal. Both are the same
;; catalog; this one reaches the Kotoba oracle, wasm and both native ISAs, which
;; the .cljc cannot. Do not edit by hand -- regenerate.
;;
;; `:topic` is a SET in the .cljc. A set has no order and `topic` is indexed by
;; position, so this file uses the order the data file writes. `by-topic-id`
;; answers by name and is unaffected.
;;
;; Parity: test/association_facts_kotoba_parity_test.clj compares every field of
;; every entry against the .cljc, so this file cannot drift from the data without
;; the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "keidanren"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 26 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 26)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (string=? f "id") (option-some-of [:option :string] "keidanren.founding-1946-08-16")
          (string=? f "title") (option-some-of [:option :string] "Keidanren gives its own founding date as 16 August 1946, in the overview table of its official profile page")
