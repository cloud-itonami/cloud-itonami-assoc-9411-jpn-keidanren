(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") 14
    (string=? candidate "membership") 5
    (string=? candidate "ethics") 14
    (string=? candidate "enforcement") 3
    (string=? candidate "disclosure") 1
    (string=? candidate "competition") 5
    (string=? candidate "human-rights") 1
    :else 0)
    0))

